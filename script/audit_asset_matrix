#!/usr/bin/env bash
set -u -o pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_ID="${AUDIT_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
BASE_DIR="${AUDIT_BASE_DIR:-$ROOT_DIR/tmp/audit_asset_matrix/$RUN_ID}"
REPORT_PATH="${AUDIT_REPORT_PATH:-$ROOT_DIR/docs/assets_audit_matrix_results.md}"
RUBYGEMS_SOURCE="${RUBYGEMS_SOURCE:-https://rubygems.org}"
TB3_GEM_GIT="${TB3_GEM_GIT:-https://github.com/coppolaf/tb3-rails-50_81}"
TB3_GEM_PATH="${TB3_GEM_PATH:-}"

mkdir -p "$BASE_DIR" "$(dirname "$REPORT_PATH")"
MATRIX_ROWS="$BASE_DIR/matrix_rows.md"
DETAILS_FILE="$BASE_DIR/details.md"
: > "$MATRIX_ROWS"
: > "$DETAILS_FILE"

cat > "$REPORT_PATH" <<REPORT
# Asset pipeline audit matrix results

- Run ID: \`$RUN_ID\`
- Repository: \`$ROOT_DIR\`
- Ruby: \`$(ruby -v 2>&1)\`
- Bundler: \`$(bundle -v 2>&1)\`
- Rubygems source: \`$RUBYGEMS_SOURCE\`
- tb3 gem git source: \`$TB3_GEM_GIT\`
- tb3 gem local path override: \`${TB3_GEM_PATH:-not set}\`
- Work directory: \`$BASE_DIR\`

This report is generated by \`script/audit_asset_matrix\`. Each matrix entry runs non-interactively and stores command logs under the work directory.

## Matrix

| Case | Rails constraint | Pipeline | Install command | Precompile command | Result |
| --- | --- | --- | --- | --- | --- |
REPORT

run_step() {
  local case_dir="$1"
  local name="$2"
  shift 2
  local log="$case_dir/${name}.log"
  echo "## $name" >> "$case_dir/commands.log"
  printf 'Command: ' >> "$case_dir/commands.log"
  printf '%q ' "$@" >> "$case_dir/commands.log"
  printf '\nLog: %s\n\n' "$log" >> "$case_dir/commands.log"
  (cd "$case_dir" && "$@") >"$log" 2>&1
}

write_dummy_app() {
  local case_dir="$1"
  local load_defaults="$2"
  local pipeline="$3"

  mkdir -p "$case_dir/config" "$case_dir/app/assets/stylesheets" "$case_dir/app/assets/javascripts" "$case_dir/public/assets"

  cat > "$case_dir/Rakefile" <<'RUBY'
require_relative "config/application"
Rails.application.load_tasks
RUBY

  cat > "$case_dir/config/routes.rb" <<'RUBY'
Rails.application.routes.draw do
end
RUBY

  cat > "$case_dir/config/environment.rb" <<'RUBY'
require_relative "application"
Rails.application.initialize!
RUBY

  cat > "$case_dir/config/application.rb" <<RUBY
require "rails"
require "action_controller/railtie"
require "action_view/railtie"
require "rails/test_unit/railtie"
require "${pipeline}/railtie"
require "twitter-bootstrap-rails"

module AuditDummy
  class Application < Rails::Application
    config.load_defaults ${load_defaults}
    config.eager_load = false
    config.secret_key_base = "audit-secret-key-base"
    config.assets.compile = true if config.respond_to?(:assets)
    config.public_file_server.enabled = true if config.respond_to?(:public_file_server)
  end
end
RUBY

  cat > "$case_dir/config/environments.rb" <<'RUBY'
# Intentionally empty: the audit matrix uses config/application.rb only.
RUBY

  cat > "$case_dir/app/assets/javascripts/application.js" <<'JS'
//= require jquery
//= require jquery_ujs
JS

  cat > "$case_dir/app/assets/stylesheets/application.css" <<'CSS'
/*
 *= require_self
 */
CSS
}

write_gemfile() {
  local case_dir="$1"
  local rails_constraint="$2"
  local pipeline="$3"

  cat > "$case_dir/Gemfile" <<GEMFILE
source "$RUBYGEMS_SOURCE"

gem "rails", "$rails_constraint"
GEMFILE

  if [[ -n "$TB3_GEM_PATH" ]]; then
    printf 'gem "twitter-bootstrap-rails", path: "%s"\n' "$TB3_GEM_PATH" >> "$case_dir/Gemfile"
  else
    printf 'gem "twitter-bootstrap-rails", git: "%s"\n' "$TB3_GEM_GIT" >> "$case_dir/Gemfile"
  fi

  if [[ "$pipeline" == "sprockets" ]]; then
    cat >> "$case_dir/Gemfile" <<'GEMFILE'
gem "sprockets-rails"
gem "jquery-rails"
GEMFILE
  else
    cat >> "$case_dir/Gemfile" <<'GEMFILE'
gem "propshaft"
gem "jquery-rails"
GEMFILE
  fi
}

run_case() {
  local name="$1"
  local rails_constraint="$2"
  local load_defaults="$3"
  local pipeline="$4"
  local case_dir="$BASE_DIR/$name"
  local install_status="not-run"
  local precompile_status="not-run"
  local result="PASS"

  mkdir -p "$case_dir"
  write_gemfile "$case_dir" "$rails_constraint" "$pipeline"
  write_dummy_app "$case_dir" "$load_defaults" "$pipeline"

  (cd "$case_dir" && bundle config set --local path "$case_dir/bundle") >"$case_dir/bundle_config.log" 2>&1 || true

  if run_step "$case_dir" "bundle_install" bundle install --jobs 3 --retry 1; then
    install_status="pass"
  else
    install_status="fail"
    result="WARN: dependency install failed"
  fi

  if [[ "$install_status" == "pass" ]]; then
    if run_step "$case_dir" "bootstrap_install_static" env BUNDLE_GEMFILE="$case_dir/Gemfile" bundle exec rails generate bootstrap:install static --trace; then
      install_status="pass"
    else
      install_status="fail"
      result="FAIL: generator failed"
    fi
  fi

  if [[ "$install_status" == "pass" ]]; then
    if run_step "$case_dir" "assets_precompile" env BUNDLE_GEMFILE="$case_dir/Gemfile" RAILS_ENV=production SECRET_KEY_BASE=audit bundle exec rails assets:precompile --trace; then
      precompile_status="pass"
    else
      precompile_status="fail"
      result="FAIL: assets precompile failed"
    fi
  fi

  printf '| `%s` | `%s` | `%s` | `%s` | `%s` | `%s` |\n' \
    "$name" "$rails_constraint" "$pipeline" "$install_status" "$precompile_status" "$result" >> "$MATRIX_ROWS"

  {
    echo
    echo "### $name"
    echo
    echo "- Rails constraint: \`$rails_constraint\`"
    echo "- Pipeline: \`$pipeline\`"
    echo "- Case directory: \`$case_dir\`"
    echo "- Command log: \`$case_dir/commands.log\`"
    echo "- Result: **$result**"
    if [[ -f "$case_dir/bundle_install.log" ]]; then
      echo "- First bundle-install diagnostic line:"
      echo '  ```text'
      awk 'NF { gsub(/```/, "` ` `"); print; count++; if (count == 8) exit }' "$case_dir/bundle_install.log" | sed 's/^/  /'
      echo '  ```'
    fi
  } >> "$DETAILS_FILE"
}

run_case "rails_6_1_sprockets" "~> 6.1.7" "6.1" "sprockets"
run_case "rails_7_2_sprockets" "~> 7.2.0" "7.2" "sprockets"
run_case "rails_7_2_propshaft" "~> 7.2.0" "7.2" "propshaft"
run_case "rails_8_0_propshaft" "~> 8.0.0" "8.0" "propshaft"
run_case "rails_8_1_propshaft" "~> 8.1.0" "8.1" "propshaft"

cat "$MATRIX_ROWS" >> "$REPORT_PATH"
printf '\n## Case details\n' >> "$REPORT_PATH"
cat "$DETAILS_FILE" >> "$REPORT_PATH"

cat >> "$REPORT_PATH" <<REPORT

## Exit policy

The script continues through the full matrix even when a case fails so the report always records every requested target. A failed dependency installation is reported as an environment warning because no application-level generator or precompile assertion can run until Bundler resolves the target gems.
REPORT

cat "$REPORT_PATH"
